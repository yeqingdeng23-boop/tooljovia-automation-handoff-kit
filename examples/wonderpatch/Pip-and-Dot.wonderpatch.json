{"format":"wonderpatch-project","version":1,"project":{"schema":1,"id":"ec0ad7f8-bc68-4e12-8789-0123fbfbeaa5","title":"Pip and Dot Open the Paper Door","kind":"theatre","theme":"fern","cover":null,"createdAt":"2026-10-31T11:23:33.180Z","updatedAt":"2026-10-31T11:23:33.180Z","revision":0,"archived":false,"content":{"cast":[{"name":"Robot Pip","kind":"robot","id":"18627c47-c0aa-41ce-ab06-8702c690d3c5"},{"name":"Little star Dot","kind":"star","id":"b5d724d0-6d5f-4e8b-91bb-0724024ce175"}],"scenes":[{"title":"The very flat door","backdrop":"garden","drawing":null,"id":"4fd9b3d0-9af0-4e0d-b9be-81e80a4ba2f4","lines":[{"speakerId":"18627c47-c0aa-41ce-ab06-8702c690d3c5","text":"This door is flatter than a pancake.","audio":null,"id":"14551f7c-b6c7-4f00-a905-437215067174"},{"speakerId":"b5d724d0-6d5f-4e8b-91bb-0724024ce175","text":"Then perhaps it opens sideways!","audio":null,"id":"fa0b49e5-e67d-41e3-ad26-18957bc5196c"},{"id":"5970ca3f-4c86-4e91-9a27-6044599faa38","speakerId":"18627c47-c0aa-41ce-ab06-8702c690d3c5","text":"Stand back. I shall knock politely: beep, beep, beep.","audio":null}]},{"title":"A room for impossible things","backdrop":"sky","drawing":null,"id":"a8300391-d641-42f9-a534-63d0bc9781bf","lines":[{"speakerId":"b5d724d0-6d5f-4e8b-91bb-0724024ce175","text":"It opened! Where does it lead?","audio":null,"id":"ff45dd3f-976f-4eaf-9eb7-4e08d17b82a9"},{"speakerId":"18627c47-c0aa-41ce-ab06-8702c690d3c5","text":"To a room with one tiny chair and enormous possibilities.","audio":null,"id":"76e0071f-6dba-45f9-893b-da2ed6ae7c88"},{"speakerId":"b5d724d0-6d5f-4e8b-91bb-0724024ce175","text":"Let's invite a cloud to tea — and save it a seat.","audio":null,"id":"70d97761-d083-441c-8e5f-ed2a82decfca"}]}]}}}